{
  "name": "@errantdata/wander",
  "version": "0.1.0",
  "description": "Walk a painted house room by room: perspective floors, routes through doors, and what a story board offers.",
  "license": "MIT",
  "author": "Sean Cantrell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errantdata/wander.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
